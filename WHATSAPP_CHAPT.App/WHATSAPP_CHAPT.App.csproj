    <ProjectReference Include="..\WHATSAPP_CHAPT.Storage\WHATSAPP_CHAPT.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Config\groq.settings.json" CopyToOutputDirectory="PreserveNewest" />
